<Application x:Class="MiToast.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- ══════════ 界面字体 ══════════
             小米 HyperOS 使用 MiSans：本机装了 MiSans 就直接生效，没装回退微软雅黑，
             保证中文字形完整、中英混排（如地址、端口）不会一半西文一半兜底字体。
             家族名按可用性回退——中文系统上叫「微软雅黑」，英文系统上是 Microsoft YaHei / Microsoft YaHei UI。
             注意：字体名是继承属性，只需在窗口/控件根元素引用，子元素与各控件样式都会继承；
             媒体控件图标（Segoe UI Symbol）与取餐码（Consolas）是符号字形，单独保留。 -->
        <FontFamily x:Key="UiFontFamily">MiSans, 微软雅黑, Microsoft YaHei, Microsoft YaHei UI</FontFamily>

        <!-- ══════════ 主题色板 ══════════
             小米 HyperOS 风格（令牌取自 miuix 组件库源码 theme/Colors.kt）：
             浅色 = 页面底 #F7F7F7、白卡片、HyperOS 蓝 #3482FF；
             深色 = 页面底纯黑 #000000、卡片 #242424、蓝 #277AF7（暗色主色与浅色不同值，别照抄同一个）。
             设置 / 历史窗口共用的色板，深浅色值由各窗口 ApplyThemeColors 在窗口层替换实例，
             DynamicResource 引用实时刷新；此处为浅色默认值。 -->
        <SolidColorBrush x:Key="PageBgBrush" Color="#FFF7F7F7"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="White"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF000000"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#99000000"/>
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="#66000000"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#FFE0E0E0"/>
        <SolidColorBrush x:Key="TrackBrush" Color="#FFE6E6E6"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#FFE8E8E8"/>
        <SolidColorBrush x:Key="ComboBgBrush" Color="White"/>
        <SolidColorBrush x:Key="FieldBgBrush" Color="#FFF0F0F0"/>
        <!-- 次级按钮/输入框族：miuix secondaryContainer 底 + onSecondaryVariant 文字 -->
        <SolidColorBrush x:Key="SecondaryFgBrush" Color="#FF303030"/>
        <!-- 分组小标题：miuix SmallTitle 的 onBackgroundVariant（HyperOS 特有的蓝灰） -->
        <SolidColorBrush x:Key="SectionTitleBrush" Color="#FF8C93B0"/>
        <!-- 主色族：miuix primary（HyperOS 蓝），悬停/按下为手工加深的配套值 -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#FF3482FF"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#FF2B74E8"/>
        <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#FF2467D6"/>
        <SolidColorBrush x:Key="PrimarySoftBrush" Color="#1F3482FF"/>
        <!-- 滑轨未激活段：miuix sliderBackground（6% 黑，深色下 15% 白） -->
        <SolidColorBrush x:Key="SliderTrackBrush" Color="#0F000000"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#FFE94634"/>


        <!-- 半透明覆盖色：自绘标题栏按钮的悬停/按下底色与滚动条滑块。
             叠在页面背景上不挑底色，深浅色两套值由各窗口 ApplyThemeColors 替换；此处为浅色默认。 -->
        <SolidColorBrush x:Key="CaptionHoverBrush" Color="#14000000"/>
        <SolidColorBrush x:Key="CaptionPressedBrush" Color="#26000000"/>
        <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#26000000"/>
        <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#4D000000"/>
        <SolidColorBrush x:Key="ScrollBarThumbActiveBrush" Color="#66000000"/>

        <!-- ══════════ 窗口级样式（设置 / 历史共用，规格对齐 miuix 组件） ══════════ -->

        <!-- 卡片分区：miuix Card = 16dp 圆角、surfaceContainer 底、无边框无阴影 -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <!-- 分组小标题：miuix SmallTitle = 14sp Bold + onBackgroundVariant -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource SectionTitleBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <!-- 列表项标题：miuix BasicComponent headline1 = 17sp Medium -->
        <Style x:Key="ItemLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- 列表项副标题：miuix body2 = 14sp + onSurfaceVariantSummary（60% 黑） -->
        <Style x:Key="ItemHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <!-- HyperOS 字号放大后提示更容易超宽：样式级自动换行兜底，
                 避免个别提示单行顶出窗口边缘被裁（如勿扰模式的“实时同步”） -->
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ToggleSwitch：HyperOS 开关 = 轨道 49×28 全圆角胶囊、thumb 20 恒白，
             关态 thumb 距边 4、开态 25（行程 21）；选中轨道用主色（miuix 无独立 checked 令牌） -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" MinHeight="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Track"
                                    Grid.Column="0"
                                    Width="49" Height="28"
                                    CornerRadius="14"
                                    Background="{DynamicResource TrackBrush}"
                                    Padding="4">
                                <Border x:Name="Thumb"
                                        Width="20" Height="20"
                                        CornerRadius="10"
                                        Background="White"
                                        HorizontalAlignment="Left">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="ThumbTranslate" X="0"/>
                                    </Border.RenderTransform>
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="0" Opacity="0.15"/>
                                    </Border.Effect>
                                </Border>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTranslate"
                                                            Storyboard.TargetProperty="X"
                                                            To="21"
                                                            Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTranslate"
                                                            Storyboard.TargetProperty="X"
                                                            To="0"
                                                            Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox：HyperOS 下拉 = 无边框填充式输入框（secondaryContainer 底、16 圆角），
             弹层为 surfaceContainer 卡片（16 圆角），选中项铺主色浅底 -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle"
                                          Focusable="False" ClickMode="Press"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBg"
                                                Background="{DynamicResource FieldBgBrush}"
                                                BorderThickness="0"
                                                CornerRadius="16">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="36"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Margin="14,0,0,0"
                                                                  VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M0,0 L8,0 L4,5 Z" Fill="{DynamicResource TextSecondaryBrush}"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Slide" Margin="0,4,0,0">
                                <Border Background="{DynamicResource ComboBgBrush}" CornerRadius="16"
                                        BorderThickness="0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Padding="6">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="4" Opacity="0.12"/>
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="260">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBg" Background="Transparent" CornerRadius="12"
                                Padding="12,9" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBg" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox：HyperOS 输入框 = 无边框填充式（secondaryContainer 底、16 圆角），
             聚焦描边变主色；静止时描边与底同色（不可见）保持 1px 占位避免聚焦时布局跳动 -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBg"
                                Background="{DynamicResource FieldBgBrush}"
                                BorderBrush="{DynamicResource FieldBgBrush}" BorderThickness="1"
                                CornerRadius="16"
                                Padding="14,0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BoxBg" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider：HyperOS 音量条样式 = 28dp 胶囊轨（激活段主色、未激活 6% 黑），
             thumb 20dp 白色圆钮约为轨道高的 0.71（对齐参考图 0.73），悬浮在胶囊内部、
             四周留出余量；激活/未激活两段在 thumb 中心相接（负边距半个圆钮宽），
             junction 处轨道比圆钮高，蓝/灰在圆钮上下两侧可见（对齐系统音量面板） -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="32" VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <!-- 灰条在下层（XAML 顺序即 z 序）：左端平头伸进蓝条底下，无可见接缝；
                                     蓝条压在灰条上面并多出 6px 盖过圆钮右缘，末端保持胶囊圆头 -->
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="28" CornerRadius="0,14,14,0"
                                                        Background="{DynamicResource SliderTrackBrush}"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Stretch"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <!-- 右侧负边距（一个 thumb 宽 + 6px）让蓝条完全没过圆钮并
                                                     再往前盖过灰条一点，蓝条末端保持胶囊圆头。
                                                     value=0 时蓝条 [0,26] 被圆钮盖住，无残留。 -->
                                                <Border Height="28" CornerRadius="14"
                                                        Background="{DynamicResource PrimaryBrush}"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Stretch"
                                                        Margin="0,0,-26,0"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="20" Height="20"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border CornerRadius="10" Background="White">
                                                        <Border.Effect>
                                                            <DropShadowEffect Color="Black" BlurRadius="6" ShadowDepth="1" Opacity="0.25"/>
                                                        </Border.Effect>
                                                    </Border>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮：miuix Button = 高 40、16 圆角、主色底白字 -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" CornerRadius="16"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="{DynamicResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="{DynamicResource PrimaryPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次按钮：miuix 次级 = secondaryVariant 底 + onSecondaryVariant 字，无边框 -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryFgBrush}"/>
            <Setter Property="Background" Value="{DynamicResource FieldBgBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" CornerRadius="16"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="{DynamicResource BorderBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 危险操作按钮（清空历史用）：HyperOS 语义红 error，悬停铺红 12% 浅底 -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="Background" Value="{DynamicResource FieldBgBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" CornerRadius="16"
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#1FE94634"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 复制小按钮（主色文字浅底） -->
        <Style x:Key="CopyButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Background" Value="#1A3482FF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#333482FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ 自绘标题栏（WindowChrome 合并标题栏后系统 caption 按钮没了，这里补回） ══════════ -->

        <!-- 标题栏按钮：占满 48px 标题行，悬停铺半透明底。
             IsHitTestVisibleInChrome 让点击落在按钮上而不是被 WindowChrome 当作标题栏拖动。 -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource CaptionHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource CaptionPressedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 关闭键：悬停铺系统同款红底、字形转白，与 Windows 标题栏行为一致（深浅色通用，不随主题换） -->
        <Style x:Key="CaptionCloseButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFE81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FFF1707A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ 细滚动条（隐式样式，设置/历史/下拉弹层里所有滚动条统一变细） ══════════
             Fluent 风格：无轨道无箭头，静置 4px 圆条，悬停加宽到 8px 并加深；
             滑块颜色用 DynamicResource，深浅色由各窗口 ApplyThemeColors 替换。 -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="12"/>
            <Setter Property="MinWidth" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" Margin="4" IsDirectionReversed="True" Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                <Rectangle Fill="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbBg" CornerRadius="4"
                                                        Background="{DynamicResource ScrollBarThumbBrush}"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBg" Property="Background"
                                                                Value="{DynamicResource ScrollBarThumbHoverBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBg" Property="Background"
                                                                Value="{DynamicResource ScrollBarThumbActiveBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Track" Property="Margin" Value="2"/>
                            </Trigger>
                            <!-- Track 的 IsDirectionReversed 只对竖向生效，横向滚条要翻回来，否则拖动方向颠倒 -->
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="12"/>
                    <Setter Property="MinHeight" Value="12"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
