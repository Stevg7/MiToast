<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon />
    <AssemblyName>MiToast</AssemblyName>
    <RootNamespace>MiToast</RootNamespace>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- DATAS（.NET 8 动态自适应应用大小）：托盘常驻、负载极小，让 GC 按需收缩堆，
         空闲时提交内存贴着实际存活对象走，避免长期驻留多个大堆 -->
    <RuntimeHostConfigurationOption Include="System.GC.DATAS" Value="true" />
  </ItemGroup>

</Project>
