<Window x:Class="MiToast.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="历史通知"
        Height="640"
        Width="800"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        Background="{DynamicResource PageBgBrush}">

    <!-- 主题色板与控件样式统一定义在 App.xaml，本窗口 ApplyTheme 按深浅色替换色板实例 -->

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 + 工具行 -->
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="历史通知"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="查看手机同步到电脑的通知记录"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,4,0,14"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox"
                         Grid.Column="0"
                         Style="{StaticResource ModernTextBox}"
                         TextChanged="SearchBox_TextChanged"/>
                <Button Grid.Column="1"
                        Content="清空历史"
                        Style="{StaticResource DangerButton}"
                        Margin="12,0,0,0"
                        Click="ClearButton_Click"/>
                <TextBlock x:Name="CountText"
                           Grid.Column="3"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="13"/>
            </Grid>
        </StackPanel>

        <ListBox x:Name="HistoryList"
                 Grid.Row="1"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource CardBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18,14"
                            Margin="0,0,10,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding AppName}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding TimeText}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="12,0,0,0"/>
                                    <TextBlock Text="{Binding CategoryText}"
                                               FontSize="12"
                                               Foreground="#FFFF6900"
                                               Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,12,0"/>
                                <TextBlock Text="{Binding Content}"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,12,0"/>
                                <TextBlock Text="{Binding CodeText}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFF6900"
                                           Visibility="{Binding CodeVisibility}"
                                           Margin="0,8,12,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="复制"
                                    Style="{StaticResource CopyButton}"
                                    VerticalAlignment="Top"
                                    Click="CopyItem_Click"
                                    Tag="{Binding}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
