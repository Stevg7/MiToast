<Window x:Class="MiToast.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="历史通知"
        Height="640"
        Width="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBgBrush}">
    <Window.Resources>
        <!-- 主题色板（与设置窗口一致，ApplyTheme 动态切换） -->
        <SolidColorBrush x:Key="PageBgBrush" Color="#FFF0F0F2"/>
        <SolidColorBrush x:Key="CardBgBrush" Color="White"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1D1D1F"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF86868B"/>
        <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF6E6E73"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#FFD1D1D6"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#FFF5F5F7"/>
        <SolidColorBrush x:Key="FieldBgBrush" Color="White"/>

        <!-- 圆角搜索框 -->
        <Style x:Key="SearchBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="#FFFF6900"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{DynamicResource FieldBgBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="14,0"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFF6900"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 危险操作按钮（清空） -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#FFFF3B30"/>
            <Setter Property="Background" Value="{DynamicResource FieldBgBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#22FF3B30"/>
                                <Setter TargetName="BtnBg" Property="BorderBrush" Value="#FFFF3B30"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 复制小按钮（橙色文字） -->
        <Style x:Key="CopyButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFFF6900"/>
            <Setter Property="Background" Value="#1AFF6900"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBg" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBg" Property="Background" Value="#33FF6900"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 + 工具行 -->
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="历史通知"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox"
                         Grid.Column="0"
                         Style="{StaticResource SearchBoxStyle}"
                         TextChanged="SearchBox_TextChanged"/>
                <Button Grid.Column="1"
                        Content="清空历史"
                        Style="{StaticResource DangerButton}"
                        Margin="12,0,0,0"
                        Click="ClearButton_Click"/>
                <TextBlock x:Name="CountText"
                           Grid.Column="3"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="13"/>
            </Grid>
        </StackPanel>

        <ListBox x:Name="HistoryList"
                 Grid.Row="1"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource CardBgBrush}"
                            CornerRadius="14"
                            Padding="16,12"
                            Margin="0,0,10,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding AppName}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding TimeText}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="12,0,0,0"/>
                                    <TextBlock Text="{Binding CategoryText}"
                                               FontSize="12"
                                               Foreground="#FFFF6900"
                                               Margin="10,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,12,0"/>
                                <TextBlock Text="{Binding Content}"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,12,0"/>
                                <TextBlock Text="{Binding CodeText}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFF6900"
                                           Visibility="{Binding CodeVisibility}"
                                           Margin="0,8,12,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="复制"
                                    Style="{StaticResource CopyButton}"
                                    VerticalAlignment="Top"
                                    Click="CopyItem_Click"
                                    Tag="{Binding}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
