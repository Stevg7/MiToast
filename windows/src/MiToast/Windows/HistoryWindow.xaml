<Window x:Class="MiToast.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="历史通知"
        Height="640"
        Width="800"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        FontFamily="{StaticResource UiFontFamily}"
        Background="{DynamicResource PageBgBrush}">

    <!-- 标题栏并入内容：与设置窗口同一套做法（见 SettingsWindow.xaml 注释）。
         本窗口可缩放，ResizeBorderThickness 保留 6px 用于拖边调整大小；
         双击标题区最大化/还原由 WindowChrome 原生处理。 -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <!-- 主题色板与控件样式统一定义在 App.xaml，本窗口 ApplyTheme 按深浅色替换色板实例 -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 自绘标题行：整行可拖动，最大化/还原图标随 StateChanged 切换（见代码后置） -->
        <Grid Background="Transparent">
            <TextBlock Text="MiToast 历史通知"
                       FontSize="12"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                <Button Style="{StaticResource CaptionButton}" Click="MinimizeButton_Click"
                        AutomationProperties.Name="最小化">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="10"/>
                </Button>
                <Button Style="{StaticResource CaptionButton}" Click="MaximizeButton_Click"
                        AutomationProperties.Name="最大化">
                    <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;"
                               FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="10"/>
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}" Click="CloseButton_Click"
                        AutomationProperties.Name="关闭">
                    <!-- miuix Close：悬停红底时随 Foreground 转白 -->
                    <Viewbox Width="11" Height="11">
                        <Canvas Width="1047.6" Height="1047.6">
                            <Path Data="F1 M 523.8,593.3 L 832.7,903.9 Q 845.0,916.5 857.1,916.3 Q 869.2,916.2 881.2,903.9 L 897.5,887.6 Q 909.6,875.6 909.7,863.8 Q 909.9,852.0 897.5,839.1 L 588.6,528.4 L 898.8,218.3 Q 911.0,206.6 911.3,194.8 Q 911.7,182.9 898.8,170.5 L 881.0,152.7 Q 858.2,129.9 833.6,153.8 L 523.8,463.6 L 213.1,154.7 Q 201.5,142.7 189.2,142.5 Q 177.0,142.3 164.6,154.7 L 148.6,171.0 Q 136.3,182.7 136.3,194.9 Q 136.3,207.1 148.2,219.2 L 458.9,528.4 L 149.1,839.1 Q 137.1,852.0 137.1,863.8 Q 137.1,875.6 149.1,887.6 L 165.5,903.9 Q 178.4,916.5 190.0,916.5 Q 201.6,916.5 214.0,903.9 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                <Path.RenderTransform>
                                    <MatrixTransform Matrix="1,0,0,-1,0,1047.6"/>
                                </Path.RenderTransform>
                            </Path>
                        </Canvas>
                    </Viewbox>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="28,8,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题 + 工具行 -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="历史通知"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="查看手机同步到电脑的通知记录"
                           FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,4,0,14"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox"
                             Grid.Column="0"
                             Style="{StaticResource ModernTextBox}"
                             TextChanged="SearchBox_TextChanged"/>
                    <Button Grid.Column="1"
                            Content="清空历史"
                            Style="{StaticResource DangerButton}"
                            Margin="12,0,0,0"
                            Click="ClearButton_Click"/>
                    <TextBlock x:Name="CountText"
                               Grid.Column="3"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="13"/>
                </Grid>
            </StackPanel>

            <ListBox x:Name="HistoryList"
                     Grid.Row="1"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="18,14"
                                Margin="0,0,10,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding AppName}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding TimeText}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="12,0,0,0"/>
                                        <TextBlock Text="{Binding CategoryText}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                   Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,12,0"/>
                                    <TextBlock Text="{Binding Content}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,12,0"/>
                                    <TextBlock Text="{Binding CodeText}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               Visibility="{Binding CodeVisibility}"
                                               Margin="0,8,12,0"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="复制"
                                        Style="{StaticResource CopyButton}"
                                        VerticalAlignment="Top"
                                        Click="CopyItem_Click"
                                        Tag="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>
