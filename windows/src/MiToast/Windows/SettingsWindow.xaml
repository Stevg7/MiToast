<Window x:Class="MiToast.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiToast 设置"
        Height="720"
        Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        FontFamily="Segoe UI"
        Background="{DynamicResource PageBgBrush}">

    <!-- 主题色板与控件样式统一定义在 App.xaml，本窗口 ApplyTheme 按深浅色替换色板实例 -->

    <!-- 触摸屏适配：PanningMode 非 None 才会响应手指拖动滚动；关闭长按/划动手势避免打断滑动；点击仍由触摸提升为鼠标事件正常响应 -->
    <ScrollViewer PanningMode="VerticalOnly" PanningDeceleration="0.0015" Stylus.IsPressAndHoldEnabled="False" Stylus.IsFlicksEnabled="False" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24">
            <!-- 标题区 -->
            <TextBlock Text="设置"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="调整通知窗口在电脑上的显示方式"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,4,0,22"/>

            <!-- 显示位置 -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="显示位置" Style="{StaticResource SectionTitle}"/>
                    <ComboBox x:Name="PositionCombo"
                              Style="{StaticResource ModernComboBox}"
                              ItemContainerStyle="{StaticResource ModernComboBoxItem}"
                              SelectedIndex="0">
                        <ComboBoxItem Content="屏幕右上角" Tag="TopRight"/>
                        <ComboBoxItem Content="屏幕右下角" Tag="BottomRight"/>
                        <ComboBoxItem Content="屏幕左上角" Tag="TopLeft"/>
                        <ComboBoxItem Content="屏幕左下角" Tag="BottomLeft"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- 连接 -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="连接" Style="{StaticResource SectionTitle}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="92"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="手机地址" Style="{StaticResource ItemLabel}"/>
                            <TextBox x:Name="PhoneHostBox"
                                     Style="{StaticResource ModernTextBox}"
                                     Margin="0,8,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="端口" Style="{StaticResource ItemLabel}"/>
                            <TextBox x:Name="PhonePortBox"
                                     Style="{StaticResource ModernTextBox}"
                                     Margin="0,8,0,0"
                                     MaxLength="5"
                                     PreviewTextInput="PhonePortBox_PreviewTextInput"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="留空则自动搜索。手机端 MiToast 首页显示的手机地址填在这里；校园网屏蔽设备发现广播时，这是最可靠的连接方式。"
                               Style="{StaticResource ItemHint}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,18"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="92"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="配对码" Style="{StaticResource ItemLabel}"/>
                            <TextBox x:Name="PairCodeBox"
                                     Style="{StaticResource ModernTextBox}"
                                     Margin="0,8,0,0"
                                     MaxLength="8"
                                     CharacterCasing="Upper"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="手机首页显示" Style="{StaticResource ItemLabel}"/>
                            <TextBlock Text="配对码"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,13,0,0"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="手机端首页「运行状态」卡片里的配对码。手机只接受配对码正确的电脑连接，填错将无法同步。"
                               Style="{StaticResource ItemHint}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,18"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="扫描本网段" Style="{StaticResource ItemLabel}"/>
                            <TextBlock Text="广播搜不到时逐个探测本机网段（较慢，且部分校园网禁止扫描行为，请确认后再开启）"
                                       Style="{StaticResource ItemHint}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,10,0"/>
                        </StackPanel>
                        <CheckBox x:Name="SweepCheck"
                                  Grid.Column="1"
                                  Style="{StaticResource ToggleSwitch}"/>
                    </Grid>

                    <Border Background="{DynamicResource HoverBrush}" CornerRadius="8" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ConnectionStatusText"
                                       Grid.Column="0"
                                       Text="正在搜索 Android 设备..."
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,10,0"/>
                            <Button x:Name="RescanButton"
                                    Grid.Column="1"
                                    Content="重新搜索"
                                    Style="{StaticResource SecondaryButton}"
                                    Height="34"
                                    Padding="16,0"
                                    Click="RescanButton_Click"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 外观 -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="外观" Style="{StaticResource SectionTitle}"/>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="深色模式" Style="{StaticResource ItemLabel}"/>
                            <TextBlock Text="将通知卡片与窗口切换为深色背景，立即生效" Style="{StaticResource ItemHint}"/>
                        </StackPanel>
                        <CheckBox x:Name="DarkModeCheck"
                                  Grid.Column="1"
                                  Style="{StaticResource ToggleSwitch}"
                                  Checked="DarkModeCheck_Toggled"
                                  Unchecked="DarkModeCheck_Toggled"/>
                    </Grid>

                    <TextBlock x:Name="WidthLabel"
                               Text="卡片宽度：480 px"
                               Style="{StaticResource ItemLabel}"
                               Margin="0,0,0,8"/>
                    <Slider x:Name="WidthSlider"
                            Style="{StaticResource ModernSlider}"
                            Minimum="320"
                            Maximum="640"
                            Value="480"
                            TickFrequency="10"
                            IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                            ValueChanged="WidthSlider_ValueChanged"/>

                    <TextBlock x:Name="MarginLabel"
                               Text="屏幕边距：40 px"
                               Style="{StaticResource ItemLabel}"
                               Margin="0,18,0,8"/>
                    <Slider x:Name="MarginSlider"
                            Style="{StaticResource ModernSlider}"
                            Minimum="8"
                            Maximum="120"
                            Value="40"
                            TickFrequency="2"
                            IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                            ValueChanged="MarginSlider_ValueChanged"/>

                    <TextBlock x:Name="GapLabel"
                               Text="卡片间距：3 px"
                               Style="{StaticResource ItemLabel}"
                               Margin="0,18,0,8"/>
                    <Slider x:Name="GapSlider"
                            Style="{StaticResource ModernSlider}"
                            Minimum="0"
                            Maximum="24"
                            Value="3"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                            ValueChanged="GapSlider_ValueChanged"/>

                    <TextBlock x:Name="DensityLabel"
                               Text="卡片紧凑度：标准"
                               Style="{StaticResource ItemLabel}"
                               Margin="0,18,0,8"/>
                    <Slider x:Name="DensitySlider"
                            Style="{StaticResource ModernSlider}"
                            Minimum="75"
                            Maximum="125"
                            Value="100"
                            TickFrequency="5"
                            IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                            ValueChanged="DensitySlider_ValueChanged"/>
                    <TextBlock Text="紧凑卡片更矮更省空间，宽松卡片更透气"
                               Style="{StaticResource ItemHint}"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- 音乐 -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="音乐" Style="{StaticResource SectionTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="音乐通知常驻" Style="{StaticResource ItemLabel}"/>
                            <TextBlock Text="音乐卡片始终置顶显示，暂停播放后也不会自动消失" Style="{StaticResource ItemHint}"/>
                        </StackPanel>
                        <CheckBox x:Name="MusicPersistentCheck"
                                  Grid.Column="1"
                                  Style="{StaticResource ToggleSwitch}"
                                  IsChecked="True"
                                  Checked="MusicPersistentCheck_Toggled"
                                  Unchecked="MusicPersistentCheck_Toggled"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 勿扰模式 -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="勿扰模式" Style="{StaticResource SectionTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="勿扰模式" Style="{StaticResource ItemLabel}"/>
                            <TextBlock Text="开启后通知仍会保存到历史但不弹出" Style="{StaticResource ItemHint}"/>
                        </StackPanel>
                        <ComboBox x:Name="DndModeCombo"
                                  Grid.Column="1"
                                  Style="{StaticResource ModernComboBox}"
                                  ItemContainerStyle="{StaticResource ModernComboBoxItem}"
                                  Width="170"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="关闭" Tag="off"/>
                            <ComboBoxItem Content="PC 端静默" Tag="pc"/>
                            <ComboBoxItem Content="同步手机勿扰" Tag="sync"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 历史 -->
            <Border Style="{StaticResource SectionCard}">
                <StackPanel>
                    <TextBlock Text="历史记录" Style="{StaticResource SectionTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="保存历史通知" Style="{StaticResource ItemLabel}"/>
                            <TextBlock Text="在电脑上保存最近 10000 条通知，相同内容自动合并显示" Style="{StaticResource ItemHint}"/>
                        </StackPanel>
                        <CheckBox x:Name="HistoryCheck"
                                  Grid.Column="1"
                                  Style="{StaticResource ToggleSwitch}"
                                  IsChecked="True"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 底部按钮区 -->
            <Grid Margin="0,8,0,8">
                <Button x:Name="HistoryButton"
                        Content="查看历史通知"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Left"
                        Click="HistoryButton_Click"/>
                <Button x:Name="SaveButton"
                        Content="保存并应用"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right"
                        Click="SaveButton_Click"/>
                <TextBlock x:Name="SavedHint"
                           Text="&#x2713; 已应用"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#FF34C759"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
