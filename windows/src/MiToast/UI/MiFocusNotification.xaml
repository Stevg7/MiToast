<UserControl x:Class="MiToast.UI.MiFocusNotification"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" Background="Transparent">
    <UserControl.Resources>
        <!-- 媒体控制按钮：透明背景、悬停浅灰圆角，图标色继承 Foreground -->
        <Style x:Key="MediaButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#FF1D1D1F"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MediaBtnBg" Background="Transparent"
                                CornerRadius="22"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MediaBtnBg" Property="Background" Value="#18808080"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MediaBtnBg" Property="Background" Value="#28808080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 妙播设备行按钮：整行可点，背景色继承 Button.Background，悬停半透明遮罩 -->
        <Style x:Key="CastRowButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RowBg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Height="{TemplateBinding Height}"
                                Padding="14,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBg" Property="Background" Value="#20808080"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RowBg" Property="Background" Value="#30808080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border x:Name="RootBorder"
            CornerRadius="20"
            Background="{x:Null}"
            Padding="20,18,20,18"
            RenderTransformOrigin="0.5,0.5">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="0" Opacity="0.12"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="CardScale" ScaleX="0.9" ScaleY="0.9"/>
                <TranslateTransform x:Name="CardTranslate" Y="-20"/>
            </TransformGroup>
        </Border.RenderTransform>
        <Border.BorderBrush>
            <SolidColorBrush x:Name="FlashBorderBrush" Color="Transparent"/>
        </Border.BorderBrush>
        
        <StackPanel>
            <Grid x:Name="HeaderGrid" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        x:Name="IconBackgroundBorder"
                        Width="44" Height="44"
                        CornerRadius="11"
                        Background="#FFF5F5F7"
                        Margin="0,0,12,0">
                    <Image x:Name="AppIconImage"
                           Width="28" Height="28"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="AppNameText"
                               FontSize="12"
                               FontWeight="Medium"
                               Foreground="#FF1D1D1F"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TimeText"
                               FontSize="10"
                               Foreground="#FF86868B"
                               Margin="0,1,0,0"/>
                </StackPanel>

                <!-- 操作按钮组 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 妙播/投放设备按钮（仅音乐卡片显示） -->
                    <Button x:Name="CastHeaderBtn"
                            Width="32" Height="32" Margin="0,0,4,0"
                            Cursor="Hand" Visibility="Collapsed"
                            Click="CastHeaderBtn_Click"
                            ToolTip="妙播 · 选择播放设备">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CastBg" Background="Transparent" CornerRadius="16">
                                    <Viewbox Width="19" Height="19" Margin="0,1,0,0">
                                        <!-- Cast 图标：屏幕 + 左下角信号波 -->
                                        <Path Fill="{TemplateBinding Foreground}"
                                              Data="M21,3 L3,3 C1.9,3 1,3.9 1,5 L1,8 L3,8 L3,5 L21,5 L21,19 L14,19 L14,21 L21,21 C22.1,21 23,20.1 23,19 L23,5 C23,3.9 22.1,3 21,3 Z M1,18 L1,21 L4,21 C4,19.34 2.66,18 1,18 Z M1,14 L1,16 C3.76,16 6,18.24 6,21 L8,21 C8,17.13 4.87,14 1,14 Z M1,10 L1,12 C6.08,12 10,15.92 10,21 L12,21 C12,14.92 7.08,10 1,10 Z"/>
                                    </Viewbox>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CastBg" Property="Background" Value="#22FF6900"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 打开 APP 按钮 -->
                    <Button x:Name="OpenAppButton"
                            Padding="10,6" Margin="0,0,6,0"
                            Cursor="Hand" Visibility="Collapsed"
                            Click="OpenAppButton_Click"
                            ToolTip="在手机上打开应用">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="OpenBg" Background="Transparent" CornerRadius="8" Padding="10,6">
                                    <TextBlock Text="打开"
                                               FontSize="11" FontWeight="Medium"
                                               Foreground="{TemplateBinding Foreground}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="OpenBg" Property="Background" Value="#22FF6900"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- 短信验证码一键复制按钮 -->
                    <Button x:Name="CopyCodeButton"
                            Padding="0"
                            Cursor="Hand"
                            Visibility="Collapsed"
                            Click="CopyCodeButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CodeButtonBorder"
                                        Background="#FFFF6900"
                                        CornerRadius="12"
                                        Padding="14,8">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CodeButtonBorder" Property="Background" Value="#FFE55E00"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="CodeButtonBorder" Property="Background" Value="#FFCC5400"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock x:Name="CopyCodeText"
                                   Text="复制验证码"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                    </Button>

                    <!-- 关闭按钮 -->
                    <Button x:Name="CloseButton"
                            Width="28" Height="28" Margin="6,0,0,0"
                            Cursor="Hand" Click="CloseButton_Click"
                            ToolTip="关闭通知">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CloseBg" Background="Transparent" CornerRadius="14">
                                    <TextBlock Text="✕"
                                               FontSize="12"
                                               Foreground="{TemplateBinding Foreground}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CloseBg" Property="Background" Value="#22000000"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
            
            <TextBlock x:Name="TitleText"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#FF1D1D1F"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       MaxHeight="60"/>

            <TextBlock x:Name="HintTitleText" Visibility="Collapsed"
                       FontSize="12"
                       FontWeight="Medium"
                       Foreground="#FF86868B"
                       Margin="0,5,0,0"
                       TextWrapping="Wrap"/>

            <TextBlock x:Name="ContentText" Visibility="Collapsed"
                       FontSize="13"
                       Foreground="#FF6E6E73"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       MaxHeight="96"/>

            <StackPanel x:Name="HintTextPanel" Visibility="Collapsed" Margin="0,5,0,0">
                <TextBlock x:Name="HintTextText"
                           FontSize="11"
                           Foreground="#FF86868B"
                           TextWrapping="Wrap"
                           MaxHeight="48"/>
            </StackPanel>
            
            <Border x:Name="PickupCodePanel" Visibility="Collapsed"
                    Margin="0,14,0,0"
                    Background="#FFFF6900"
                    CornerRadius="14"
                    Padding="16,12,16,12">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="取餐码"
                               FontSize="11"
                               FontWeight="Medium"
                               Foreground="#FFFFFFFF"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,2"/>
                    <TextBlock x:Name="PickupCodeText"
                               FontSize="36"
                               FontWeight="Bold"
                               FontFamily="Consolas"
                               Foreground="#FFFFFFFF"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>
                </StackPanel>
            </Border>
            
            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,12,0,0">
                <StackPanel x:Name="StageBar" Orientation="Horizontal" HorizontalAlignment="Left"/>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StageLabelText"
                               FontSize="12"
                               FontWeight="Medium"
                               Foreground="#FFFF6900"/>
                    <TextBlock x:Name="ProgressPercentText"
                               Grid.Column="1"
                               FontSize="11"
                               Foreground="#FF86868B"/>
                </Grid>
            </StackPanel>

            <!-- 媒体控件面板：♥  ⏮  ⏸(大)  ⏭  词  + 进度条 -->
            <Border x:Name="MediaPanel" Visibility="Collapsed"
                    Margin="0,16,0,0" CornerRadius="20" Padding="18,14,18,14"
                    Background="#FFF5F5F7">
                <StackPanel>
                    <!-- 控制按钮行 -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 收藏 -->
                        <Button x:Name="MediaFavoriteBtn" Grid.Column="0"
                                Style="{StaticResource MediaButton}"
                                Width="42" Height="38"
                                HorizontalAlignment="Center"
                                Visibility="Collapsed"
                                Click="MediaAction_Click" ToolTip="收藏">
                            <TextBlock x:Name="MediaFavoriteGlyph"
                                       Text="&#x2661;" FontSize="24"
                                       FontFamily="Segoe UI Symbol, Segoe UI"/>
                        </Button>

                        <!-- 上一曲 -->
                        <Button x:Name="MediaPrevBtn" Grid.Column="1"
                                Style="{StaticResource MediaButton}"
                                Width="42" Height="38"
                                HorizontalAlignment="Center"
                                Visibility="Collapsed"
                                Click="MediaAction_Click" ToolTip="上一曲">
                            <TextBlock Text="&#x23EE;" FontSize="20"
                                       FontFamily="Segoe UI Symbol, Segoe UI"/>
                        </Button>

                        <!-- 播放/暂停（居中加大） -->
                        <Button x:Name="MediaPlayPauseBtn" Grid.Column="2"
                                Style="{StaticResource MediaButton}"
                                Width="52" Height="40"
                                HorizontalAlignment="Center"
                                Visibility="Collapsed"
                                Click="MediaAction_Click" ToolTip="播放/暂停">
                            <TextBlock x:Name="MediaPlayPauseGlyph"
                                       Text="&#x23F8;" FontSize="28"
                                       FontFamily="Segoe UI Symbol, Segoe UI"/>
                        </Button>

                        <!-- 下一曲 -->
                        <Button x:Name="MediaNextBtn" Grid.Column="3"
                                Style="{StaticResource MediaButton}"
                                Width="42" Height="38"
                                HorizontalAlignment="Center"
                                Visibility="Collapsed"
                                Click="MediaAction_Click" ToolTip="下一曲">
                            <TextBlock Text="&#x23ED;" FontSize="20"
                                       FontFamily="Segoe UI Symbol, Segoe UI"/>
                        </Button>

                        <!-- 歌词 -->
                        <Button x:Name="MediaLyricBtn" Grid.Column="4"
                                Style="{StaticResource MediaButton}"
                                Width="42" Height="38"
                                HorizontalAlignment="Center"
                                Visibility="Collapsed"
                                Click="MediaAction_Click" ToolTip="歌词开关">
                            <Grid Width="28" Height="28">
                                <TextBlock x:Name="MediaLyricGlyph"
                                           Text="&#x8BCD;" FontSize="22" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <!-- 激活态右下角对勾角标 -->
                                <Border x:Name="LyricCheckBadge"
                                        Width="14" Height="14" CornerRadius="7"
                                        Background="#FFFF6900"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,-4,-4"
                                        Visibility="Collapsed">
                                    <TextBlock Text="&#x2713;" FontSize="9" FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>
                    </Grid>

                    <!-- 进度行：当前时间 —— 进度条 —— 总时长 -->
                    <Grid x:Name="MediaProgressRow" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="MediaCurTimeText" Grid.Column="0"
                                   Text="00:00" FontSize="10"
                                   Foreground="#FF86868B"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Border x:Name="MediaTrack" Height="4" CornerRadius="2"
                                    Background="#FFD1D1D6" ClipToBounds="True">
                                <Border x:Name="MediaFill" Height="4" CornerRadius="2"
                                        Background="#FFFF6900"
                                        RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="MediaFillScale" ScaleX="0"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="MediaTotalTimeText" Grid.Column="2"
                                   Text="00:00" FontSize="10"
                                   Foreground="#FF86868B"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>

                    <!-- 妙播设备列表：点击右上角妙播按钮展开 -->
                    <StackPanel x:Name="CastDevicePanel" Visibility="Collapsed" Margin="0,14,0,2"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
